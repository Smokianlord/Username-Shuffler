# Auto detect text files and perform LF normalization
* text=auto

# Python and text files
*.py text eol=lf
*.pyw text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.xlsx binary
*.xlsm binary
*.png binary
*.ico binary
*.exe binary
*.zip binary
